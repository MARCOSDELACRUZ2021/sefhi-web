---
const pillars = [
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12.75L11.25 15 15 9.75m-3-7A9 9 0 1 0 12 21a9 9 0 0 0 0-18z" />`,
    label: 'Protección certificada',
    bg: 'bg-brand-orange-soft',
    color: 'text-brand-orange-dark',
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />`,
    label: 'Respuesta rápida',
    bg: 'bg-brand-blue-soft',
    color: 'text-brand-blue',
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.562.562 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" />`,
    label: 'Resultados reales',
    bg: 'bg-green-50',
    color: 'text-green-600',
  },
];
---

<section id="about" class="relative section-padding overflow-hidden bg-brand-light">

  <!-- Decoración de fondo -->
  <div class="absolute top-0 right-0 w-64 h-64 bg-brand-orange-soft rounded-full blur-[80px] opacity-55 pointer-events-none" aria-hidden="true" />
  <div class="absolute bottom-0 left-0 w-48 h-48 bg-brand-blue-dark/25 rounded-full blur-[80px] opacity-65 pointer-events-none" aria-hidden="true" />

  <div class="relative container-custom mx-auto max-w-7xl">
    <div class="grid lg:grid-cols-2 gap-16 items-center">

      <!-- Izquierda: Visual (tarjeta amigable) -->
      <div class="relative order-2 lg:order-1 animate-on-scroll-left">
        <div class="relative">

          <!-- Tarjeta principal -->
          <div class="bg-white rounded-3xl shadow-card-hover border border-brand-border overflow-hidden">

            <!-- Banner top -->
            <div class="bg-gradient-to-r from-brand-orange to-brand-blue-dark p-6 flex items-center gap-4">
              <div class="w-12 h-12 rounded-xl bg-white/20 flex items-center justify-center">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
              </div>
              <div>
                <p class="font-bold text-white text-lg">Reporte de Inspección</p>
                <p class="text-white/70 text-sm">SEFHI Professional · Certificado</p>
              </div>
              <div class="ml-auto">
                <span class="px-3 py-1.5 rounded-full bg-white/20 text-white text-xs font-bold">✓ Aprobado</span>
              </div>
            </div>

            <!-- Lista de verificación -->
            <div class="p-6 flex flex-col gap-4">
              {[
                'Inspección visual completa del área',
                'Identificación de focos de riesgo',
                'Análisis de puntos críticos de control',
                'Tratamiento aplicado y documentado',
                'Plan preventivo establecido',
                'Certificación sanitaria emitida',
              ].map((item) => (
                <div class="flex items-center gap-3 p-3 rounded-xl bg-brand-light hover:bg-brand-orange-pale transition-colors duration-200">
                  <div class="w-6 h-6 rounded-full bg-brand-orange flex items-center justify-center flex-shrink-0">
                    <svg class="w-3.5 h-3.5 text-white" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                    </svg>
                  </div>
                  <span class="text-sm font-medium text-brand-body">{item}</span>
                </div>
              ))}

              <!-- Barra de progreso -->
              <div class="pt-3 border-t border-brand-border">
                <div class="flex justify-between text-sm mb-2">
                  <span class="font-semibold text-brand-body">Nivel de protección</span>
                  <span class="font-bold text-brand-orange">98%</span>
                </div>
                <div class="h-3 bg-gray-100 rounded-full overflow-hidden">
                  <div class="h-full w-[98%] bg-gradient-to-r from-brand-orange-light to-brand-orange-dark rounded-full" />
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Derecha: Texto -->
      <div class="flex flex-col gap-7 order-1 lg:order-2">

        <div class="animate-on-scroll" data-delay="0">
          <span class="section-badge">¿Qué es SEFHI?</span>
        </div>

        <h2 class="text-4xl xl:text-5xl font-bold leading-tight tracking-tight text-brand-dark animate-on-scroll" data-delay="80">
          Más que fumigar,
          <span class="gradient-text"> te protegemos.</span>
        </h2>

        <div class="flex flex-col gap-5 animate-on-scroll" data-delay="160">
          <p class="text-base text-brand-muted leading-relaxed">
            SEFHI es una empresa especializada en <span class="text-brand-body font-semibold">control profesional de plagas e higiene industrial</span>, enfocada en proteger negocios, hogares e instituciones con soluciones técnicas, preventivas y certificables.
          </p>
          <p class="text-base text-brand-muted leading-relaxed">
            Trabajamos con restaurantes, hoteles, cafeterías, hospitales, industrias, escuelas, oficinas y hogares que necesitan mantener <span class="text-brand-body font-semibold">espacios seguros, limpios y libres de riesgos sanitarios.</span>
          </p>
          <p class="text-base text-brand-muted leading-relaxed">
            Nuestro enfoque va más allá de fumigar: <span class="text-brand-orange-dark font-semibold">ayudamos a proteger la reputación, operación y cumplimiento sanitario</span> de nuestros clientes.
          </p>
        </div>

        <!-- Pilares -->
        <div class="grid grid-cols-3 gap-3 animate-on-scroll" data-delay="240">
          {pillars.map((pillar) => (
            <div class={`flex flex-col items-center gap-2 p-4 rounded-xl ${pillar.bg} border border-transparent hover:border-brand-border text-center transition-all duration-300 hover:shadow-card cursor-default`}>
              <div class={`w-10 h-10 rounded-xl bg-white shadow-card flex items-center justify-center`}>
                <svg class={`w-5 h-5 ${pillar.color}`} fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <Fragment set:html={pillar.icon} />
                </svg>
              </div>
              <span class="text-xs font-semibold text-brand-body leading-tight">{pillar.label}</span>
            </div>
          ))}
        </div>

        <div class="animate-on-scroll" data-delay="320">
          <a href="/contacto" class="btn-primary self-start">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
            Solicitar inspección gratis
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
