---
---

<section id="hero" class="relative min-h-screen flex items-center overflow-hidden bg-white">

  <!-- Fondo decorativo suave -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <!-- Blob naranja top-right -->
    <div class="absolute -top-24 -right-24 w-[480px] h-[480px] bg-brand-orange-soft rounded-full blur-[80px] opacity-70 animate-float-slow" />
    <!-- Blob morado profundo bottom-left -->
    <div class="absolute -bottom-32 -left-16 w-[400px] h-[400px] bg-brand-blue-darker/25 rounded-full blur-[100px] opacity-70 animate-float" style="animation-delay:-4s;" />
    <!-- Blob cyan centro -->
    <div class="absolute top-1/2 right-1/3 w-[280px] h-[280px] bg-brand-blue-dark/20 rounded-full blur-[90px] opacity-60 animate-float-slow" style="animation-delay:-6s;" />
    <!-- Puntos decorativos -->
    <div class="absolute top-1/3 left-8 w-2 h-2 rounded-full bg-brand-orange/40 animate-float" style="animation-delay:-1s;" />
    <div class="absolute top-1/2 right-1/4 w-3 h-3 rounded-full bg-brand-blue-dark/40 animate-float-slow" style="animation-delay:-3s;" />
    <div class="absolute bottom-1/3 left-1/3 w-2 h-2 rounded-full bg-brand-blue-darker/35 animate-float" style="animation-delay:-2s;" />
  </div>

  <div class="relative container-custom mx-auto px-4 sm:px-6 lg:px-8 pt-28 pb-20 max-w-7xl w-full">
    <div class="grid lg:grid-cols-2 gap-14 items-center">

      <!-- Izquierda: Contenido -->
      <div class="flex flex-col gap-7">

        <!-- Badge amigable -->
        <div class="section-badge self-start animate-on-scroll" data-delay="0">
          <span class="w-2 h-2 rounded-full bg-brand-orange animate-pulse" />
          Control profesional y certificado
        </div>

        <!-- Título -->
        <div class="animate-on-scroll" data-delay="80">
          <h1 class="text-5xl sm:text-6xl xl:text-7xl font-black leading-[1.06] tracking-tight text-balance text-brand-dark">
            La plaga más<br />
            peligrosa… es<br />
            <span class="gradient-text">la que no ves.</span>
          </h1>
        </div>

        <!-- Subtítulo -->
        <p class="text-lg sm:text-xl text-brand-muted leading-relaxed max-w-xl animate-on-scroll" data-delay="160">
          Inspección, prevención y control profesional para proteger tu operación y
          <span class="text-brand-body font-semibold"> la tranquilidad de tus clientes.</span>
        </p>

        <!-- Descripción -->
        <p class="text-base text-brand-muted leading-relaxed max-w-lg animate-on-scroll" data-delay="240">
          SEFHI protege negocios, hogares e instituciones con soluciones técnicas, preventivas y certificables.
        </p>

        <!-- Botones CTA -->
        <div class="flex flex-wrap gap-4 animate-on-scroll" data-delay="320">
          <a href="/contacto" class="btn-primary">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
            Solicitar inspección gratis
          </a>
          <a href="/servicios" class="btn-outline">
            Ver servicios
          </a>
        </div>

        <!-- Indicadores de confianza -->
        <div class="flex flex-wrap gap-8 pt-2 animate-on-scroll" data-delay="400">
          {[
            { value: '+500', label: 'Clientes protegidos' },
            { value: '12+', label: 'Años de experiencia' },
            { value: '100%', label: 'Certificados' },
          ].map((stat) => (
            <div class="flex flex-col">
              <span class="text-3xl font-black gradient-text leading-none">{stat.value}</span>
              <span class="text-xs text-brand-muted font-medium mt-1">{stat.label}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Derecha: Composición visual amigable -->
      <div class="relative hidden lg:flex items-center justify-center animate-on-scroll-right" data-delay="150">
        <div class="relative w-full max-w-[420px]">

          <!-- Tarjeta principal (ilustración amigable) -->
          <div class="relative bg-white rounded-3xl shadow-[0_20px_60px_rgba(0,0,0,0.10)] border border-brand-border p-8 animate-float">

            <!-- Encabezado de la tarjeta -->
            <div class="flex items-center gap-4 mb-6">
              <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-brand-orange to-brand-orange-dark flex items-center justify-center shadow-orange flex-shrink-0">
                <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"
                    d="M9 12.75L11.25 15 15 9.75m-3-7A9 9 0 1 0 12 21a9 9 0 0 0 0-18z" />
                </svg>
              </div>
              <div>
                <p class="font-bold text-brand-dark text-base">Reporte de inspección</p>
                <p class="text-sm text-brand-muted">SEFHI · Completado hoy</p>
              </div>
              <span class="ml-auto px-3 py-1 rounded-full bg-green-50 text-green-600 text-xs font-bold border border-green-200">
                ✓ Aprobado
              </span>
            </div>

            <!-- Lista de verificación -->
            <div class="flex flex-col gap-3">
              {[
                { label: 'Inspección visual del área', done: true },
                { label: 'Identificación de focos de riesgo', done: true },
                { label: 'Tratamiento aplicado', done: true },
                { label: 'Plan preventivo activo', done: true },
                { label: 'Certificado emitido', done: true },
              ].map((item) => (
                <div class="flex items-center gap-3">
                  <div class={`w-5 h-5 rounded-full flex items-center justify-center flex-shrink-0 ${item.done ? 'bg-brand-orange' : 'bg-gray-100 border border-gray-300'}`}>
                    {item.done && (
                      <svg class="w-3 h-3 text-white" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                      </svg>
                    )}
                  </div>
                  <span class="text-sm text-brand-body">{item.label}</span>
                </div>
              ))}
            </div>

            <!-- Barra de progreso -->
            <div class="mt-5 pt-4 border-t border-brand-border">
              <div class="flex justify-between text-sm mb-2">
                <span class="font-medium text-brand-body">Nivel de protección</span>
                <span class="font-bold text-brand-orange">98%</span>
              </div>
              <div class="h-2.5 bg-gray-100 rounded-full overflow-hidden">
                <div class="h-full w-[98%] bg-gradient-to-r from-brand-orange-light to-brand-orange rounded-full" />
              </div>
            </div>
          </div>

          <!-- Tarjeta flotante 1 — estado de zona -->
        </div>
      </div>
    </div>
  </div>

  <!-- Franja de logos/sectores — confianza -->

</section>
