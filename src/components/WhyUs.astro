const sectors = ['Restaurantes', 'Hoteles', 'Hospitales', 'Industrias', 'Escuelas', 'Oficinas', 'Hogares', 'Cafeterías'];
---

<section id="why-us" class="relative section-padding overflow-hidden bg-brand-light">

  <!-- Decoración de fondo -->
  <div class="absolute top-0 right-0 w-80 h-80 bg-brand-orange-soft rounded-full blur-[100px] opacity-45 pointer-events-none" aria-hidden="true" />
  <div class="absolute bottom-0 left-0 w-64 h-64 bg-brand-blue-darker/20 rounded-full blur-[80px] opacity-60 pointer-events-none" aria-hidden="true" />

  <div class="relative container-custom mx-auto max-w-7xl">

    <!-- Encabezado -->
    <div class="flex flex-col items-center text-center gap-5 mb-16">
      <span class="section-badge animate-on-scroll" data-delay="0">Por qué elegirnos</span>
      <h2 class="text-4xl xl:text-5xl font-bold leading-tight tracking-tight text-brand-dark max-w-3xl animate-on-scroll" data-delay="80">
        La diferencia entre fumigar
        <span class="gradient-text"> y realmente proteger</span>
      </h2>
      <p class="text-base text-brand-muted max-w-xl leading-relaxed animate-on-scroll" data-delay="160">
        En SEFHI no solo aplicamos productos. Construimos un sistema de protección sanitaria con resultados reales y documentados.
      </p>
    </div>

    <!-- Grid de razones -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5 mb-14">
      {reasons.map((reason, index) => (
        <div
          class="group card p-6 rounded-2xl flex flex-col gap-4 animate-on-scroll bg-white"
          data-delay={String((index % 4) * 70)}
        >
          <div class="flex items-start justify-between gap-2">
            <div class={`w-11 h-11 rounded-xl ${reason.bg} flex items-center justify-center flex-shrink-0 transition-transform duration-300 group-hover:scale-110`}>
              <svg class={`w-5 h-5 ${reason.iconColor}`} fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <Fragment set:html={reason.icon} />
              </svg>
            </div>
            <div class="flex flex-col items-end">
              <span class={`text-xl font-black ${reason.statColor} leading-none`}>{reason.stat}</span>
              <span class="text-[10px] text-brand-subtle font-medium text-right leading-tight mt-0.5">{reason.statLabel}</span>
            </div>
          </div>

          <div class="flex flex-col gap-1.5">
            <h3 class="text-sm font-bold text-brand-dark leading-snug">{reason.title}</h3>
            <p class="text-xs text-brand-muted leading-relaxed">{reason.description}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- Sectores -->
    <div class="animate-on-scroll" data-delay="0">
      <div class="relative overflow-hidden rounded-3xl border border-brand-border bg-gradient-to-br from-white via-white to-brand-light/60 shadow-[0_18px_50px_rgba(0,0,0,0.08)] p-8 sm:p-10">
        <div class="absolute -top-16 -right-16 w-56 h-56 rounded-full bg-brand-orange-soft/60 blur-3xl pointer-events-none" aria-hidden="true"></div>
        <div class="absolute -bottom-20 -left-20 w-64 h-64 rounded-full bg-brand-blue-dark/20 blur-3xl pointer-events-none" aria-hidden="true"></div>

        <div class="relative flex flex-col lg:flex-row items-center gap-10">
          <div class="flex flex-col gap-4 lg:w-80 flex-shrink-0 text-center lg:text-left">

            <h3 class="text-2xl sm:text-3xl font-bold text-brand-dark leading-tight">Sectores que atendemos</h3>
            <p class="text-sm text-brand-muted leading-relaxed max-w-sm mx-auto lg:mx-0">
              Adaptamos nuestro servicio a las necesidades de cada tipo de espacio y cliente.
            </p>
          </div>

          <div class="flex flex-wrap gap-3 justify-center lg:justify-start">
            {sectors.map((sector, i) => (
              <span
                class="group px-4 py-2.5 rounded-full text-sm font-semibold text-brand-body bg-white/90 border border-brand-border/90 shadow-sm backdrop-blur-sm hover:-translate-y-0.5 hover:shadow-md hover:bg-gradient-to-r hover:from-brand-orange-soft hover:to-white hover:text-brand-orange-dark hover:border-brand-orange/30 transition-all duration-300 cursor-default"
                style={`animation-delay: ${i * 45}ms`}
              >
                <span class="inline-flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-brand-orange/50 group-hover:bg-brand-orange-dark transition-colors duration-300" aria-hidden="true"></span>
                  {sector}
                </span>
              </span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
