---
const currentYear = new Date().getFullYear();

const links = {
  services: [
    { label: 'Control de plagas', href: '/servicios' },
    { label: 'Higiene industrial', href: '/servicios' },
    { label: 'Inspecciones técnicas', href: '/servicios' },
    { label: 'Programas preventivos', href: '/servicios' },
  ],
  company: [
    { label: '¿Qué es SEFHI?', href: '/nosotros' },
    { label: 'Por qué elegirnos', href: '/por-que-elegirnos' },
    { label: 'Sectores que servimos', href: '/por-que-elegirnos' },
    { label: 'Contacto', href: '/contacto' },
  ],
};
---

<footer class="relative overflow-hidden bg-brand-blue-darker border-t border-white/10">

  <!-- Decoración de fondo -->
  <div class="absolute -top-16 left-1/2 -translate-x-1/2 w-[600px] h-[300px] bg-brand-orange/8 rounded-full blur-[100px] pointer-events-none" aria-hidden="true" />
  <div class="absolute bottom-0 right-0 w-[300px] h-[200px] bg-brand-blue-dark/12 rounded-full blur-[80px] pointer-events-none" aria-hidden="true" />

  <div class="relative container-custom mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

    <!-- Contenido principal -->
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-10 py-14 border-b border-white/10">

      <!-- Columna de marca -->
      <div class="lg:col-span-2 flex flex-col gap-6">
        <a href="/" class="flex items-center group self-start" aria-label="SEFHI inicio">
          <img
            src="/images/logo-.png"
            alt="SEFHI"
            class="h-20 sm:h-24 w-auto object-contain transition-all duration-300 group-hover:scale-[1.02]"
            loading="lazy"
            decoding="async"
          />
        </a>

        <p class="text-sm text-white/60 leading-relaxed max-w-sm">
          Empresa especializada en control profesional de plagas e higiene industrial. Protegemos tu negocio, hogar e institución con soluciones técnicas certificables.
        </p>

        <!-- Datos de contacto -->
        <div class="flex flex-col gap-3">
          <a
            href="https://wa.me/9611901506"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-3 text-sm text-white/60 hover:text-white transition-colors duration-300 group"
          >
            <div class="w-8 h-8 rounded-lg bg-white/10 flex items-center justify-center group-hover:bg-brand-orange/20 transition-colors duration-300">
              <svg class="w-4 h-4 text-brand-orange-light" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
              </svg>
            </div>
            +52 961 190 1506
          </a>
          <a
            href="mailto:contacto@sefhi.mx"
            class="flex items-center gap-3 text-sm text-white/60 hover:text-white transition-colors duration-300 group"
          >
            <div class="w-8 h-8 rounded-lg bg-white/10 flex items-center justify-center group-hover:bg-brand-orange/20 transition-colors duration-300">
              <svg class="w-4 h-4 text-brand-orange-light" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            fumigacionsefhi@gmail.com
          </a>

          <!-- Redes sociales -->
          <div class="flex flex-col gap-2 pt-2">
          <span class="text-xs font-semibold text-white/40 uppercase tracking-wider">Síguenos en nuestras redes sociales</span>
          <div class="flex items-center gap-3">
            <a
              href="https://www.instagram.com/fumigacionsefhi"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Instagram de SEFHI"
              class="w-11 h-11 rounded-xl bg-white/10 flex items-center justify-center hover:bg-[#E1306C]/25 transition-colors duration-300 group"
            >
              <svg class="w-5 h-5 text-brand-orange-light group-hover:text-[#E1306C] transition-colors duration-300" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
              </svg>
            </a>
            <a
              href="https://www.facebook.com/fumigacionsefhi"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Facebook de SEFHI"
              class="w-11 h-11 rounded-xl bg-white/10 flex items-center justify-center hover:bg-[#1877F2]/25 transition-colors duration-300 group"
            >
              <svg class="w-5 h-5 text-brand-orange-light group-hover:text-[#1877F2] transition-colors duration-300" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            </a>
          </div>
          </div>
        </div>
      </div>

      <!-- Links de servicios -->
      <div class="flex flex-col gap-5">
        <h4 class="text-sm font-bold text-white tracking-wider uppercase">Servicios</h4>
        <ul class="flex flex-col gap-3">
          {links.services.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-white/55 hover:text-brand-orange-light transition-colors duration-300 flex items-center gap-2 group"
              >
                <span class="w-1 h-1 rounded-full bg-brand-orange/50 group-hover:bg-brand-orange-light transition-colors duration-300" />
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Links de empresa -->
      <div class="flex flex-col gap-5">
        <h4 class="text-sm font-bold text-white tracking-wider uppercase">Empresa</h4>
        <ul class="flex flex-col gap-3">
          {links.company.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-white/55 hover:text-brand-orange-light transition-colors duration-300 flex items-center gap-2 group"
              >
                <span class="w-1 h-1 rounded-full bg-brand-orange/50 group-hover:bg-brand-orange-light transition-colors duration-300" />
                {link.label}
              </a>
            </li>
          ))}
        </ul>

        <!-- Badge COFEPRIS -->
        <div class="mt-3 px-4 py-3 rounded-xl bg-white/8 border border-white/10 flex items-center gap-2">
          <img
            src="/images/nazar.png"
            alt="Nazar"
            class="w-4 h-4 object-contain flex-shrink-0"
            loading="lazy"
            decoding="async"
          />
          <span class="text-xs text-white/50 leading-tight">Certificados y registrados ante COFEPRIS</span>
        </div>
      </div>
    </div>

    <!-- Barra inferior -->
    <div class="py-5 flex flex-col sm:flex-row items-center justify-between gap-3">
      <p class="text-xs text-white/30">
        © {currentYear} SEFHI. Todos los derechos reservados 👽.
      </p>
      <p class="text-xs text-white/25">
        Control profesional de plagas e higiene industrial · <span class="text-brand-orange-light/60">SEFHI</span>
      </p>
    </div>
  </div>
</footer>
